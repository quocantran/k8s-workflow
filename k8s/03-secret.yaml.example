# File mẫu Secret (Tuyệt đối không lưu mật khẩu thật vào Git)
# Copy file này thành 03-secret.yaml để deploy local hoặc tạo qua GitHub Secrets / K8s CLI
apiVersion: v1
kind: Secret
metadata:
  name: movie-db-secret
  namespace: movie-booking
type: Opaque
stringData:
  DB_USER: "movie_user"
  DB_PASSWORD: "CHANGE_ME_IN_PRODUCTION"
